      ],
      "rate_hz": null
    }
  },
  "$defs": {
    "AlertState": {
      "additionalProperties": false,
      "description": "alert.state, on every status change.",
      "properties": {
        "alert_id": {
          "title": "Alert Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "distraction",
            "microsleep",
            "drowsiness",
            "phone",
            "no_face",
            "road_rage",
            "zoning_out",
            "crash_candidate",
            "checkin_due",
            "break_due"
          ],
          "title": "Type",
          "type": "string"
        },
        "tier": {
          "enum": [
            "T1",
            "T2",
            "T3"
          ],
          "title": "Tier",
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "held",
            "speaking",
            "listening",
            "closed",
            "escalated"
          ],
          "title": "Status",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "reply": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reply"
        },
        "intent": {
          "anyOf": [
            {
              "enum": [
                "OK",
                "NOT_OK",
                "ANSWER",
                "HELP",
                "UNCLEAR",
                "NONE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intent"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        }
      },
      "required": [
        "alert_id",
        "type",
        "tier",
        "status",
        "text"
      ],
      "title": "AlertState",
      "type": "object"
    },
    "AudioFeatures": {
      "additionalProperties": false,
      "description": "audio.features, 5 Hz.",
      "properties": {
        "loudness_db": {
          "title": "Loudness Db",
          "type": "number"
        },
        "baseline_db": {
          "title": "Baseline Db",
          "type": "number"
        },
        "shouting": {
          "title": "Shouting",
          "type": "boolean"
        },
        "speaking": {
          "title": "Speaking",
          "type": "boolean"
        },
        "swear_count_60s": {
          "minimum": 0,
          "title": "Swear Count 60S",
          "type": "integer"
        },
        "anger_voice_p": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anger Voice P"
        }
      },
      "required": [
        "loudness_db",
        "baseline_db",
        "shouting",
        "speaking",
        "swear_count_60s"
      ],
      "title": "AudioFeatures",
      "type": "object"
    },
    "BioHR": {
      "additionalProperties": false,
      "description": "bio.hr, 1 Hz.",
      "properties": {
        "bpm": {
          "exclusiveMinimum": 0.0,
          "title": "Bpm",
          "type": "number"
        },
        "rr_ms": {
          "items": {
            "type": "number"
          },
          "title": "Rr Ms",
          "type": "array"
        },
        "source": {
          "enum": [
            "suunto",
            "strap",
            "sim"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "bpm",
        "source"
      ],
      "title": "BioHR",
      "type": "object"
    },
    "CameraFrame": {
      "additionalProperties": false,
      "description": "camera.frame, 5 Hz. 320 px wide JPEG; never written to disk.",
      "properties": {
        "jpeg_b64": {
          "title": "Jpeg B64",
          "type": "string"
        }
      },
      "required": [
        "jpeg_b64"
      ],
      "title": "CameraFrame",
      "type": "object"
    },
    "CheckinSchedule": {
      "additionalProperties": false,
      "description": "checkin.schedule, on change.",
      "properties": {
        "interval_min": {
          "exclusiveMinimum": 0.0,
          "title": "Interval Min",
          "type": "number"
        },
        "next_checkin_ts": {
          "title": "Next Checkin Ts",
          "type": "number"
        },
        "next_break_ts": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
