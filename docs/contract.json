        "core"
      ],
      "rate_hz": null
    },
    "audio.features": {
      "model": {
        "$ref": "#/$defs/AudioFeatures"
      },
      "producers": [
        "voice"
      ],
      "rate_hz": 5.0
    },
    "voice.status": {
      "model": {
        "$ref": "#/$defs/VoiceStatus"
      },
      "producers": [
        "voice"
      ],
      "rate_hz": null
    },
    "voice.reply": {
      "model": {
        "$ref": "#/$defs/VoiceReply"
      },
      "producers": [
        "voice"
      ],
      "rate_hz": null
    },
    "voice.say": {
      "model": {
        "$ref": "#/$defs/VoiceSay"
      },
      "producers": [
        "core"
      ],
      "rate_hz": null
    },
    "alert.state": {
      "model": {
        "$ref": "#/$defs/AlertState"
      },
      "producers": [
        "core"
      ],
      "rate_hz": null
    },
    "vehicle.motion": {
      "model": {
        "$ref": "#/$defs/VehicleMotion"
      },
      "producers": [
        "core"
      ],
      "rate_hz": 10.0
    },
    "control.music": {
      "model": {
        "$ref": "#/$defs/ControlMusic"
      },
      "producers": [
        "core"
      ],
      "rate_hz": null
    },
    "checkin.schedule": {
      "model": {
        "$ref": "#/$defs/CheckinSchedule"
      },
      "producers": [
        "core"
      ],
      "rate_hz": null
    },
    "trip.summary": {
      "model": {
        "$ref": "#/$defs/TripSummary"
      },
      "producers": [
        "core"
      ],
      "rate_hz": null
    },
    "music.volume": {
      "model": {
        "$ref": "#/$defs/MusicVolume"
      },
      "producers": [
        "ui"
      ],
      "rate_hz": null
    },
    "bio.hr": {
      "model": {
        "$ref": "#/$defs/BioHR"
      },
      "producers": [
        "hr",
        "ui"
      ],
      "rate_hz": 1.0
    },
    "context.road": {
      "model": {
        "$ref": "#/$defs/ContextRoad"
      },
      "producers": [
        "maps",
        "ui"
      ],
      "rate_hz": 1.0
    },
    "control.trip": {
      "model": {
        "$ref": "#/$defs/ControlTrip"
      },
      "producers": [
        "ui"
      ],
      "rate_hz": null
    },
    "control.replay": {
      "model": {
        "$ref": "#/$defs/ControlReplay"
      },
      "producers": [
        "ui"
      ],
      "rate_hz": null
    },
    "control.inject": {
      "model": {
        "$ref": "#/$defs/ControlInject"
      },
      "producers": [
