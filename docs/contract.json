    "MusicVolume": {
      "additionalProperties": false,
      "description": "music.volume, on change.",
      "properties": {
        "volume": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Volume",
          "type": "number"
        },
        "playing": {
          "title": "Playing",
          "type": "boolean"
        }
      },
      "required": [
        "volume",
        "playing"
      ],
      "title": "MusicVolume",
      "type": "object"
    },
    "Pretrip": {
      "additionalProperties": false,
      "description": "Pre-trip form (CI-01). Departure time is the control.trip envelope ts.",
      "properties": {
        "planned_min": {
          "exclusiveMinimum": 0.0,
          "title": "Planned Min",
          "type": "number"
        },
        "sleep_h": {
          "maximum": 24.0,
          "minimum": 0.0,
          "title": "Sleep H",
          "type": "number"
        },
        "awake_h": {
          "minimum": 0.0,
