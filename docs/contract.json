          "title": "Src",
          "type": "string"
        },
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        }
      },
      "required": [
        "topic",
        "ts",
        "src",
        "data"
      ],
      "title": "Envelope",
      "type": "object"
    },
    "HeadPose": {
      "additionalProperties": false,
      "properties": {
        "yaw": {
          "description": "degrees",
          "title": "Yaw",
          "type": "number"
        },
        "pitch": {
          "description": "degrees",
          "title": "Pitch",
          "type": "number"
        },
        "roll": {
          "description": "degrees",
          "title": "Roll",
          "type": "number"
        }
      },
      "required": [
        "yaw",
        "pitch",
        "roll"
      ],
      "title": "HeadPose",
