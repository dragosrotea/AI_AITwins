        }
      },
      "required": [
        "interval_min",
        "next_checkin_ts"
      ],
      "title": "CheckinSchedule",
      "type": "object"
    },
    "ContextRoad": {
      "additionalProperties": false,
      "description": "context.road, 1 Hz.",
      "properties": {
        "load": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ],
          "title": "Load",
          "type": "string"
        },
        "traffic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Traffic"
        },
        "next_maneuver": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Maneuver"
        },
        "dist_m": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dist M"
        }
      },
      "required": [
        "load"
      ],
      "title": "ContextRoad",
      "type": "object"
    },
    "ControlInject": {
      "additionalProperties": false,
      "description": "control.inject, on event.",
