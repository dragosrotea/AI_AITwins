          "type": "string"
        },
        "source": {
          "enum": [
            "replay",
            "sim"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "accel_long_g",
        "accel_lat_g",
        "accel_mag_g",
        "speed_kmh",
        "lat",
        "lon",
        "road",
        "source"
      ],
      "title": "VehicleMotion",
      "type": "object"
    },
    "VoiceReply": {
      "additionalProperties": false,
      "description": "voice.reply, on event. intent NONE means no reply within listen_s.",
      "properties": {
        "alert_id": {
          "title": "Alert Id",
          "type": "string"
        },
        "transcript": {
          "title": "Transcript",
          "type": "string"
        },
        "intent": {
          "enum": [
            "OK",
            "NOT_OK",
            "ANSWER",
            "HELP",
            "UNCLEAR",
            "NONE"
          ],
          "title": "Intent",
          "type": "string"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "path": {
          "enum": [
            "keyword",
            "llm"
          ],
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "alert_id",
        "transcript",
        "intent",
        "latency_ms",
        "path"
      ],
      "title": "VoiceReply",
      "type": "object"
    },
    "VoiceSay": {
      "additionalProperties": false,
      "description": "voice.say, on event.",
      "properties": {
        "alert_id": {
          "title": "Alert Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "tier": {
          "enum": [
            "T1",
            "T2",
            "T3"
          ],
          "title": "Tier",
          "type": "string"
        },
        "lang": {
          "enum": [
            "ro",
            "en"
          ],
          "title": "Lang",
          "type": "string"
        },
        "listen_s": {
          "default": 8.0,
          "minimum": 0.0,
          "title": "Listen S",
