          "type": "number"
        },
        "tiredness": {
          "maximum": 5,
          "minimum": 1,
          "title": "Tiredness",
          "type": "integer"
        },
        "caffeine": {
          "description": "caffeine in the last 2 h",
          "title": "Caffeine",
          "type": "boolean"
        },
        "engagement": {
          "enum": [
            "trivia",
            "fact",
            "quiet"
          ],
          "title": "Engagement",
          "type": "string"
        },
        "lang": {
          "enum": [
            "ro",
            "en"
          ],
          "title": "Lang",
          "type": "string"
        },
        "emergency_contact": {
          "description": "phone number, E.164",
          "title": "Emergency Contact",
          "type": "string"
        },
        "resting_hr": {
          "exclusiveMinimum": 0.0,
          "title": "Resting Hr",
          "type": "number"
        }
      },
      "required": [
        "planned_min",
        "sleep_h",
        "awake_h",
        "tiredness",
        "caffeine",
        "engagement",
        "lang",
        "emergency_contact",
        "resting_hr"
      ],
      "title": "Pretrip",
      "type": "object"
    },
    "TripSummary": {
      "additionalProperties": false,
      "description": "trip.summary, at trip end.",
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "stats": {
          "additionalProperties": true,
          "title": "Stats",
          "type": "object"
        }
      },
      "required": [
        "text"
      ],
      "title": "TripSummary",
      "type": "object"
    },
