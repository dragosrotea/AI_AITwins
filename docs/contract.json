{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DriveMate bus contract",
  "version": "1.0.0",
  "description": "Generated from backend/schemas.py by scripts/export_schema.py. Do not edit by hand.",
  "envelope": {
    "$ref": "#/$defs/Envelope"
  },
  "topics": {
