            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "action"
      ],
      "title": "ControlTrip",
      "type": "object"
    },
    "DetectorEvent": {
      "additionalProperties": false,
      "description": "detector.event, on event. Visual events from CV, fusion events from core.",
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "distraction",
            "microsleep",
            "drowsiness",
            "phone",
            "no_face",
            "road_rage",
            "zoning_out",
            "crash_candidate",
            "checkin_due",
            "break_due"
          ],
          "title": "Type",
          "type": "string"
        },
        "tier": {
          "enum": [
            "T1",
            "T2",
            "T3"
          ],
          "title": "Tier",
          "type": "string"
        },
        "score": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "signals": {
          "additionalProperties": true,
          "title": "Signals",
          "type": "object"
        }
      },
      "required": [
        "event_id",
        "type",
        "tier",
        "score"
      ],
      "title": "DetectorEvent",
      "type": "object"
    },
    "DriverState": {
      "additionalProperties": false,
      "description": "driver.state, 10 Hz. With no face, send 0 or the last value; face_present says why.",
      "properties": {
        "face_present": {
          "title": "Face Present",
          "type": "boolean"
        },
        "eye_closed_p": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Eye Closed P",
          "type": "number"
        },
        "eyes_closed_ms": {
          "description": "current continuous eye closure",
          "minimum": 0,
          "title": "Eyes Closed Ms",
          "type": "integer"
        },
        "perclos_60s": {
          "description": "fraction of the last 60 s closed",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Perclos 60S",
          "type": "number"
        },
        "blink_rate_pm": {
          "description": "blinks per minute",
          "minimum": 0.0,
          "title": "Blink Rate Pm",
          "type": "number"
        },
        "gaze_dispersion_30s": {
          "description": "degrees",
          "minimum": 0.0,
          "title": "Gaze Dispersion 30S",
          "type": "number"
        },
        "head": {
          "$ref": "#/$defs/HeadPose"
        },
        "yawn_p": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Yawn P",
          "type": "number"
        },
        "yawns_10m": {
          "minimum": 0,
          "title": "Yawns 10M",
          "type": "integer"
        },
        "anger_p": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Anger P",
          "type": "number"
        },
        "zoning_visual_p": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Zoning Visual P",
          "type": "number"
        },
        "phone_in_hand": {
          "title": "Phone In Hand",
          "type": "boolean"
        },
        "fps": {
          "minimum": 0.0,
          "title": "Fps",
          "type": "number"
        }
      },
      "required": [
        "face_present",
        "eye_closed_p",
        "eyes_closed_ms",
        "perclos_60s",
        "blink_rate_pm",
        "gaze_dispersion_30s",
        "head",
        "yawn_p",
        "yawns_10m",
        "anger_p",
        "zoning_visual_p",
        "phone_in_hand",
        "fps"
      ],
      "title": "DriverState",
      "type": "object"
