          "title": "Event",
          "type": "string"
        }
      },
      "required": [
        "event"
      ],
      "title": "ControlInject",
      "type": "object"
    },
    "ControlMusic": {
      "additionalProperties": false,
      "description": "control.music, on event.",
      "properties": {
        "duck": {
          "title": "Duck",
          "type": "boolean"
        },
        "level": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Level",
          "type": "number"
        }
      },
      "required": [
        "duck",
        "level"
      ],
      "title": "ControlMusic",
      "type": "object"
    },
    "ControlReplay": {
      "additionalProperties": false,
      "description": "control.replay, on event. trip picks the replay trip; segment is the seek position.",
      "properties": {
        "action": {
          "enum": [
            "play",
            "pause",
            "seek"
          ],
          "title": "Action",
          "type": "string"
        },
        "trip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trip"
        },
        "segment": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "seconds from trip start",
          "title": "Segment"
        }
      },
      "required": [
        "action"
      ],
      "title": "ControlReplay",
      "type": "object"
    },
    "ControlTrip": {
      "additionalProperties": false,
      "description": "control.trip, on event. pretrip is required on start.",
