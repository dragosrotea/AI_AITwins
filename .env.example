# Copy to .env and fill in. Never commit .env.

# LLM (provider chosen by the voice engineer, VOICE-T04)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Twilio emergency call and SMS (X3, CR-03)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EMERGENCY_CONTACT_NUMBER=

# Google Maps (X2)
GOOGLE_MAPS_API_KEY=
# Browser-side key: restrict it to the dashboard origin in the Google Cloud console
VITE_GOOGLE_MAPS_API_KEY=

# Config profile: empty for normal, "demo" for shortened time windows
DRIVEMATE_PROFILE=
