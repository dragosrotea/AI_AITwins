# Copy to .env (cp .env.example .env) and fill in. Never commit .env.
# Without a key everything still runs: alerts, trivia and the trip summary use templates
# and the offline question bank.

# LLM: provider "groq" (reads GROQ_API_KEY) or "openai" (reads OPENAI_API_KEY)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
OPENAI_API_KEY=

# Config profile: empty for normal, "demo" for shortened time windows.
# Usually set on the command line instead: DRIVEMATE_PROFILE=demo scripts/run_all.sh
DRIVEMATE_PROFILE=
